---
description: 
globs: 
alwaysApply: false
---
name: Mars Credit Miner
platform: macOS
architecture: arm64
version: 1.0.0

description: |
  A native macOS application for mining Mars Credit (MARS) on Apple Silicon Macs.
  This application interfaces with a custom Ethereum fork (v1.10.18) to perform proof-of-work mining and allows secure account generation and management.

requirements:
  - macOS >= 12.0
  - Apple Silicon (M1/M2/M3)
  - Internet access for RPC sync
  - Ports 8546 (HTTP/WS), 30304 (P2P) open
  - Xcode 14.0+ (for source builds)

rpc:
  url: https://rpc.marscredit.xyz:443
  usage:
    - Fetch latest block for sync
    - Broadcast mining rewards

mining:
  binary: geth
  version: 1.10.18
  mode: proof-of-work
  networkid: 110110
  bootnodes:
    - enode://bf93a274569cd009e4172c1a41b8bde1fb8d8e7cff1e5130707a0cf5be4ce0fc673c8a138ecb7705025ea4069da8c1d4b7ffc66e8666f7936aa432ce57693353@roundhouse.proxy.rlwy.net:50590
    - enode://ca3639067a580a0f1db7412aeeef6d5d5e93606ed7f236a5343fe0d1115fb8c2bea2a22fa86e9794b544f886a4cb0de1afcbccf60960802bf00d81dab9553ec9@monorail.proxy.rlwy.net:26254
    - enode://7f2ee75a1c112735aaa43de1e5a6c4d7e07d03a5352b5782ed8e0c7cc046a8c8839ad093b09649e0b4a6ed8900211fb4438765c99d07bb00006ef080a1aa9ab6@viaduct.proxy.rlwy.net:30270
    - enode://98710174f4798dae1931e417944ac7a7fb3268d38ef8d3941c8fcc44fe178b118003d8b3d61d85af39c561235a1708f8dd61f8ba47df4c4a6b9156e272af2cfc@monorail.proxy.rlwy.net:29138
  dagdir: /data/.ethash

geth_startup_script: |
  geth --datadir /data \
       --keystore /app/keystore \
       --syncmode "full" \
       --http \
       --http.addr "0.0.0.0" \
       --http.port 8546 \
       --http.api personal,eth,net,web3,miner,admin \
       --http.vhosts=* \
       --http.corsdomain=* \
       --networkid 110110 \
       --ws \
       --ws.addr "0.0.0.0" \
       --ws.port 8546 \
       --port 30304 \
       --nat "any" \
       --mine \
       --miner.threads=1 \
       --miner.etherbase YOUR_WALLET_ADDRESS_HERE_FOR_MINING_REWARDS \
       --bootnodes="<see above>" \
       --verbosity 6 \
       --maxpeers 50 \
       --cache 2048 \
       --ethash.dagdir /data/.ethash

features:
  - Native Apple Silicon Support
  - One-click start/stop mining
  - Account generation with 12-word mnemonic backup
  - Keystore private key storage
  - macOS Keychain password integration
  - Secure RPC-based syncing and block monitoring
  - Clean, modern macOS GUI

account_management:
  - On "Generate Account":
      - Generate a new wallet address
      - Save private key to /app/keystore
      - Display 12-word mnemonic for backup
  - Mnemonic must be viewable on-demand through UI (one-click)

build:
  source_repo: https://github.com/marscredit/miner-apple-silicon.git
  build_steps:
    - git clone https://github.com/marscredit/miner-apple-silicon.git
    - cd miner-apple-silicon
    - swift build -c release
    - run via: .build/release/MarsCredit

ui:
  framework: SwiftUI
  actions:
    - Launch App
    - Enter Secure Password
    - Click "Generate Account"
    - Save displayed mnemonic
    - Click "Start Mining"

security:
  mnemonic_display: one-click reveal
  password_storage: macOS Keychain
  private_key_encryption: true